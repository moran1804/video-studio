# =============================================================================
# AI Social Video Studio – configuration
# Copy to .env (Docker Compose) or to your TrueNAS config dataset as studio.env
# Lines starting with # are comments. Never commit the real file.
# =============================================================================

APP_NAME=AI Social Video Studio
# Public URL the browser uses (your HTTPS reverse-proxy URL). Used for secure
# cookies and CSRF origin checks.
APP_URL=https://studio.example.com
# Host port the web UI is published on.
APP_PORT=3000
# Extra origins allowed to make changes (comma separated), e.g. a LAN URL:
ALLOWED_ORIGINS=http://truenas.local:3000
# Honour X-Forwarded-For from your reverse proxy (for rate limiting).
TRUST_PROXY=true

# --- Authentication -----------------------------------------------------------
AUTH_ENABLED=true
ADMIN_EMAIL=admin@example.com
# At least 10 characters. Used only to create the first admin account.
ADMIN_PASSWORD=
# Set to true once to reset the admin password to ADMIN_PASSWORD, then back to false.
ADMIN_RESET_PASSWORD=false
# 32+ random characters: openssl rand -hex 32
# Also encrypts API keys saved in Settings – keep it stable.
SESSION_SECRET=
SESSION_TTL_DAYS=14

# --- Containers (user / database) --------------------------------------------
# TrueNAS "apps" user is 568:568.
PUID=568
PGID=568
POSTGRES_PASSWORD=change-me-to-a-long-random-password
DATABASE_URL=postgres://studio:change-me-to-a-long-random-password@postgres:5432/studio
REDIS_URL=redis://redis:6379

# --- Storage -------------------------------------------------------------------
DATA_ROOT=/data
MAX_UPLOAD_MB=1000

# --- Mock mode -----------------------------------------------------------------
# true = simulate every AI provider (no paid API calls). Great for a first run.
MOCK_PROVIDERS=false

# --- OpenAI (briefs, storyboards, prompts, vision, transcription) -------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5
# Optional separate vision model (defaults to OPENAI_MODEL)
OPENAI_VISION_MODEL=
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-transcribe

# --- Google Gemini API (video generation) -------------------------------------
GOOGLE_GEMINI_API_KEY=
# Gemini Omni Flash model id – confirm the exact id in Google AI Studio.
GOOGLE_VIDEO_MODEL=
# Veo 3.1 model id (optional provider)
GOOGLE_VEO_MODEL=veo-3.1-generate-preview
# Clip lengths the model accepts (seconds, comma separated)
GOOGLE_VIDEO_DURATIONS=4,6,8
# Optional: 720p or 1080p (leave empty for the provider default)
GOOGLE_VIDEO_RESOLUTION=
# Image model for character references and keyframes (Nano Banana Pro).
GOOGLE_IMAGE_MODEL=gemini-3-pro-image

# --- Runway (optional video provider) ------------------------------------------
RUNWAY_API_KEY=
RUNWAY_VIDEO_MODEL=gen4.5
RUNWAY_VIDEO_DURATIONS=5,10

# --- Kling (optional): motion transfer – a character copies the movement of a video ---
# An API key, or a legacy pair written as ACCESS_KEY:SECRET_KEY (signed as a JWT). Can also be set in Settings.
KLING_API_KEY=
KLING_API_BASE_URL=https://api-singapore.klingai.com
KLING_MOTION_MODEL=kling-v3.0-motion-control
# std (720p) or pro (1080p)
KLING_MOTION_MODE=pro
RUNWAY_API_VERSION=2024-11-06

# --- ElevenLabs (voiceovers) -----------------------------------------------------
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_multilingual_v2

# --- Defaults & tuning ------------------------------------------------------------
# google | veo | runway | mock
DEFAULT_VIDEO_PROVIDER=google
# Estimated cost per generated second (USD) shown in Settings → usage
COST_PER_SECOND_GOOGLE=0.15
COST_PER_SECOND_VEO=0.40
COST_PER_SECOND_RUNWAY=0.12
COST_PER_SECOND_KLING=0.18
# Estimated cost per generated image (character references, keyframes).
COST_PER_IMAGE=0.13
GENERATION_CONCURRENCY=3
RENDER_CONCURRENCY=1
# 0 = let FFmpeg decide. Lower it to keep CPU free for other TrueNAS apps.
FFMPEG_THREADS=0
GENERATION_POLL_SECONDS=10
GENERATION_TIMEOUT_MINUTES=20
HTTP_TIMEOUT_SECONDS=60

LOG_LEVEL=info
